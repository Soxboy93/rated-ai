# --- Required ---
NODE_ENV=production
PORT=3000
# MySQL 8 / MariaDB connection string
DATABASE_URL=mysql://user:password@localhost:3306/rated_ai
# Random string, 32+ chars (e.g. `openssl rand -base64 48`). Signs session and parent-unlock tokens.
JWT_SECRET=

# --- AI provider: Claude (recommended) ---
# Set the key as a SECRET in your hosting environment (never in a file that is committed, never in a chat).
# With a key set, Claude is used automatically. See docs/AI_PROVIDER.md.
ANTHROPIC_API_KEY=
# Same key under another name, for hosts that reserve ANTHROPIC_API_KEY (e.g. Claude Code cloud environments).
RATEDAI_CLAUDE_KEY=
# anthropic | openai. Leave empty to pick automatically (anthropic when ANTHROPIC_API_KEY is set).
LLM_PROVIDER=
# One model per job. These are the defaults; change only after evaluating.
CLAUDE_MODEL_LESSON=claude-opus-5-5
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_SAFETY=claude-haiku-5-5
# CLAUDE_MODEL_ASSISTANT / CLAUDE_MODEL_VISION / CLAUDE_MODEL_SUMMARY default to CLAUDE_MODEL_CHAT.
# Optional gateway in front of Anthropic's API.
# ANTHROPIC_API_URL=https://api.anthropic.com
# Set to 0 to stop asking Anthropic to re-run declined requests on a fallback model.
# CLAUDE_FALLBACKS=0

# --- AI provider: any OpenAI-compatible API (used when no Anthropic key is set, and for story pictures) ---
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Model used for homework photos; must support image input. Defaults to LLM_MODEL.
LLM_VISION_MODEL=
# Model used for story illustrations / avatars.
IMAGE_MODEL=gpt-image-1
# Safety check of each child message by an AI model in addition to the keyword rules.
# Claude: on unless set to 0. OpenAI-compatible: set to 1 to call the provider's /moderations endpoint.
LLM_MODERATION=

# --- Optional ---
# Comma-separated emails that receive the admin role when they register.
ADMIN_EMAILS=
# Privacy contact shown to parents on the consent screen. Set before launch.
PRIVACY_CONTACT_EMAIL=
# Shown in the browser tab / UI.
VITE_APP_TITLE="Rated AI"

# --- Docker Compose only (docker-compose.yml) ---
DB_PASSWORD=
DB_ROOT_PASSWORD=
